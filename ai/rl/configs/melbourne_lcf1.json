{
  "env": {
    "actionHz": 20,
    "episodeSecs": 90,
    "reset": { "tracks": ["melbourne"], "cars": ["lcf1"] }
  },
  "reward": {},
  "sac": {
    "gamma": 0.995,
    "n_step": 5,
    "batch_size": 1024,
    "grad_clip": 10.0,
    "actor": { "kind": "mlp", "mlp_layers": [256, 256] },
    "critic": { "kind": "mlp", "mlp_layers": [512, 512, 512] }
  },
  "replay": { "capacity": 5000000 },
  "collect": { "num_workers": 6, "envs_per_worker": 16 },
  "eval": { "every_secs": 180, "combos": [["melbourne", "lcf1"]] }
}
