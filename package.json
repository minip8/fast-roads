{
  "name": "fast-roads",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p test",
    "test": "vitest run --project unit",
    "test:laps": "vitest run --project laps",
    "tracks:outlines": "UPDATE_OUTLINES=1 vitest run --project unit test/tracks.test.ts -t outline"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.5",
    "@types/three": "0.185.4",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
